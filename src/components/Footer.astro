---
import { APP_URL, SALES_EMAIL, COMPANY, CVR } from '../site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img class="on-light" src="/logos/cde-lockup.svg" alt="CAN Data Extract" height="24" />
      <img class="on-dark" src="/logos/cde-lockup-paper-trace.svg" alt="CAN Data Extract" height="24" />
      <p class="site-footer__tagline">Record, decode, simulate and share automotive diagnostic traffic.</p>
    </div>
    <nav class="site-footer__nav" aria-label="Product">
      <p class="label">Product</p>
      <a href="/product/">Online app and desktop app</a>
      <a href="/pricing/">Pricing</a>
      <a href="/download/">Download</a>
      <a href="/docs/">Docs</a>
      <a href={APP_URL}>Log in</a>
    </nav>
    <nav class="site-footer__nav" aria-label="Company">
      <p class="label">Company</p>
      <a href="/company/">About</a>
      <a href={`mailto:${SALES_EMAIL}`}>Contact sales</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {COMPANY} · CVR {CVR}</p>
    <a class="mono" href={`mailto:${SALES_EMAIL}`}>{SALES_EMAIL}</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-sunken);
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-16) var(--space-12);
  }
  .site-footer__brand img { height: 24px; width: auto; max-width: 100%; object-fit: contain; object-position: left; }
  .site-footer__tagline { margin-top: var(--space-8); font-size: 14px; line-height: 22px; color: var(--ink-muted); max-width: 36ch; }
  .site-footer__nav { display: flex; flex-direction: column; gap: var(--space-4); }
  .site-footer__nav .label { color: var(--ink-muted); text-transform: uppercase; margin-bottom: var(--space-2); }
  .site-footer__nav a { font-size: 14px; line-height: 20px; color: var(--ink); text-decoration: none; }
  .site-footer__nav a:hover { color: var(--trace); text-decoration: underline; }
  .site-footer__legal {
    display: flex; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap;
    padding-block: var(--space-8) var(--space-12);
    border-top: 1px solid var(--line);
    font-size: 13px; color: var(--ink-muted);
  }
  .site-footer__legal a { color: var(--ink-muted); }
  @media (max-width: 800px) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
</style>
