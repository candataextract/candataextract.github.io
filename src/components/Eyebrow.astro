---
// Uppercase `label` text above a heading.
interface Props {
  as?: 'span' | 'p' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={['label', 'eyebrow', className].filter(Boolean).join(' ')}><slot /></Tag>

<style is:global>
  .eyebrow { text-transform: uppercase; color: var(--trace); }
</style>
