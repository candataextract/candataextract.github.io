---
import Screenshot from './Screenshot.astro';
import { SHOTS } from '../screenshots';

// One feature beside its screenshot. Alternate `reverse` down the page.
interface Props {
  shot: keyof typeof SHOTS;
  spec?: string;
  reverse?: boolean;
}
const { shot, spec, reverse = false } = Astro.props;
---

<div class={['row', reverse && 'row--reverse'].filter(Boolean).join(' ')}>
  <div class="row__text">
    <h3 class="h3">{SHOTS[shot].title}</h3>
    <p class="row__body"><slot /></p>
    {spec && <p class="row__spec">{spec}</p>}
  </div>
  <Screenshot name={shot} class="row__shot" />
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-16);
    align-items: center;
  }
  .row + .row { margin-top: var(--space-24); }
  .row--reverse { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .row--reverse .row__text { order: 2; }
  .row__body { margin-top: var(--space-6); color: var(--ink-muted); font-size: 16px; line-height: 26px; }
  .row__spec {
    margin-top: var(--space-8); padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font: 400 12px/18px var(--font-mono); color: var(--ink);
  }
  @media (max-width: 860px) {
    .row, .row--reverse { grid-template-columns: 1fr; gap: var(--space-10); }
    .row--reverse .row__text { order: 0; }
    .row + .row { margin-top: var(--space-16); }
  }
</style>
