---
import Eyebrow from './Eyebrow.astro';

// A page section: eyebrow + display-2 heading + optional lede + content.
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  tone?: 'surface' | 'sunken';
  id?: string;
  class?: string;
}
const { eyebrow, title, lede, tone = 'surface', id, class: className } = Astro.props;
---

<section id={id} class={['section', tone === 'sunken' && 'section--sunken', className].filter(Boolean).join(' ')}>
  <div class="container">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    {title && <h2 class="display-2 section__title">{title}</h2>}
    {lede && <p class="lede section__lede">{lede}</p>}
    <div class="section__body"><slot /></div>
  </div>
</section>

<style>
  .section { padding-block: var(--space-24) 0; }
  .section--sunken {
    background: var(--surface-sunken);
    border-block: 1px solid var(--line);
    padding-block: var(--space-24);
    margin-top: var(--space-24);
  }
  .section__title { margin-top: var(--space-6); max-width: 28ch; color: var(--ink); }
  .section__lede { margin-top: var(--space-8); }
  .section__body { margin-top: var(--space-16); }
  @media (max-width: 700px) {
    .section { padding-block: var(--space-16) 0; }
    .section--sunken { padding-block: var(--space-16); margin-top: var(--space-16); }
    .section__body { margin-top: var(--space-12); }
  }
</style>
